WITH base_data AS
(
    SELECT
        TO_CHAR(
            CASE
                WHEN cad.cde_type_alert = 'REAP'
                    THEN cad.dte_crtd_alert
                ELSE cad.dte_crtd_queue_autd
            END,
            'YYYYMM'
        ) AS dte_yyyymm,

        CASE
            WHEN cad.cde_type_alert = 'REAP'
                THEN cad.dte_crtd_alert
            ELSE cad.dte_crtd_queue_autd
        END AS automated_queue_created_date,

        ciraof.idn_edw_case_indiv,
        ciraof.idn_edw_alert_cis,
        ciraof.idn_edw_prcs_autmn_rte,
        ciraof.dte_load_edw,
        ciraof.txt_gtpost,
        ciraof.idn_edw_case_cis,

        ciraof.idn_reason_rnwl_auto_failed,
        ciraof.idn_reason_rnwl_auto_final,
        ciraof.idn_status_rnwl_auto_failed,
        ciraof.idn_status_rnwl_auto_final,

        cad.idn_edw_alert_cis AS idn_edw_alert_cis_cad,
        cad.cde_type_alert,
        cad.nam_type_alert,
        cad.dte_crtd_queue_autd,
        cad.dte_crtd_alert,
        cad.idn_alert_cis,
        cad.cde_reason_alert,
        cad.nam_reason_alert,
        cad.idn_case_cis,
        cad.idn_client,
        cad.idn_case_combo,
        cad.cde_status_auto,
        cad.cde_excpt_indiv,
        cad.ind_wi_reappln,
        cad.cde_cat_prog_rnwl_post,
        cad.cde_cat_prog_rnwl_pre,
        cad.cde_status_prog_rnwl_pre,
        cad.cde_type_target_rnwl_pre

    FROM cis_rptng.t_case_indiv_rnwl_autmn_otcm_fact ciraof

    INNER JOIN cis_rptng.t_cis_alert_dim cad
        ON ciraof.idn_edw_alert_cis = cad.idn_edw_alert_cis

    WHERE ciraof.txt_gtpost IS NOT NULL
),

gateposts AS
(
    SELECT 'TOTAL' AS gatepost_group, '%B%' AS gatepost_pattern
    FROM dual

    UNION ALL

    SELECT 'EMR', '%EMR%'
    FROM dual

    UNION ALL

    SELECT 'MS', '%MS%'
    FROM dual
)

SELECT
    b.*,
    g.gatepost_group
FROM base_data b
INNER JOIN gateposts g
    ON b.txt_gtpost LIKE g.gatepost_pattern

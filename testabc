IF ATTR([PARENT CATEPOS]) = "Total Renewals" THEN
    REPLACE(FORMAT([Numerator Count], "#,##0"), ",", "'")

ELSEIF MIN([Denominator Count]) = -1 THEN
    REPLACE(FORMAT([Numerator Count], "#,##0"), ",", "'")

ELSEIF ISNULL([Numerator Count])
    OR [Numerator Count] = 0
    OR ISNULL(MIN([Denominator Count]))
    OR MIN([Denominator Count]) = 0
THEN
    REPLACE(FORMAT([Numerator Count], "#,##0"), ",", "'")
    + " / 0%"

ELSE
    REPLACE(FORMAT([Numerator Count], "#,##0"), ",", "'")
    + " / "
    + STR(
        ROUND(
            ([Numerator Count] / MIN([Denominator Count])) * 100,
            0
        )
    )
    + "%"

END

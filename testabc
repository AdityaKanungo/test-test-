-- ============================================================
-- CASE-LEVEL KPI VALIDATION
-- ============================================================

SELECT
    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%A%'
        THEN cad.idn_case_cis
    END) AS total_renewals,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%B%'
        THEN cad.idn_case_cis
    END) AS selected_for_emr,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%C%'
        THEN cad.idn_case_cis
    END) AS selected_for_ms,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%D%'
        THEN cad.idn_case_cis
    END) AS selected_for_ar,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%E%'
        THEN cad.idn_case_cis
    END) AS selected_for_as,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%F%'
        THEN cad.idn_case_cis
    END) AS full_automation_successful_ar,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%G%'
        THEN cad.idn_case_cis
    END) AS partial_automation_successful_ar,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%H%'
        THEN cad.idn_case_cis
    END) AS no_automated_renewal,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%I%'
        THEN cad.idn_case_cis
    END) AS automated_scheduling,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%J%'
        THEN cad.idn_case_cis
    END) AS manual_scheduling,

    COUNT(DISTINCT CASE
        WHEN ciraof.txt_gtpost LIKE '%K%'
        THEN cad.idn_case_cis
    END) AS successful_as

FROM cis_rptng.t_case_indiv_rnwl_autmn_otcm_fact ciraof

INNER JOIN cis_rptng.t_cis_alert_dim cad
    ON ciraof.idn_edw_alert_cis = cad.idn_edw_alert_cis;
